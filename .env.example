# Wave API Credentials (Required)
WAVE_API_KEY=your_wave_full_access_token
WAVE_BUSINESS_ID=your_wave_business_id

# Business Information (for PDF invoices)
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS1=City, State ZIP
BUSINESS_ADDRESS2=Country
BUSINESS_PHONE=Your Phone Number

# Paths (optional - defaults shown)
LOGO_PATH=./assets/logo.png
INVOICE_OUTPUT_DIR=./invoices
